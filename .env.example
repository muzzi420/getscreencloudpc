# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Pexels API (free stock videos) - get at pexels.com/api
PEXELS_API_KEY=your_pexels_api_key_here

# TikTok Account Credentials (for auto-posting)
TIKTOK_EMAIL=your_tiktok_email@example.com
TIKTOK_PASSWORD=your_tiktok_password

# Optional: ElevenLabs for better voiceover (leave empty to use free gTTS)
ELEVENLABS_API_KEY=

# How many niches to analyze per run
NICHES_PER_RUN=5

# How many videos to create per niche
VIDEOS_PER_NICHE=1

# Schedule: how many hours between automation runs (default 6)
RUN_EVERY_HOURS=6
